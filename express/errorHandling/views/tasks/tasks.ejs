<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>All tasks</h1>

    <% for(let task of tasks) { %>
        <div>
            <p><%= task.task %></p>
            <a href="/tasks/<%= task._id %>">View</a>
        </div>
    <% } %>
</body>
</html>